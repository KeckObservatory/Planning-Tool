{
    "title": "Star List Target Params",
    "description": "This document defines the schema for the Keck Star List Targets",
    "type": "object",
    "properties": {
        "target_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 15,
            "pattern": "[\\w\\-\\s]+",
            "short_description": "Target Name",
            "description": "Target Name. Alpha-numeric, hyphen, underscore, and space characters only"
        },
        "priority": {
            "type": ["number", "string"],
            "short_description": "Priority",
            "description": "Priority for the target list. Higher numbers come first. Targets with no priority are set to 0.",
            "pattern": "^[\\+\\-]?\\d+\\.?\\d*$|^[\\+\\-]?\\.\\d+$|^\\.\\d+$|^\\d+\\.\\d+$"
        },
        "semids": {
            "type": "array",
            "short_description": "Semids",
            "description": "Semester Ids, comma separated",
            "items": {
                "description": "comprised of semids that other coobservers can view/edit",
                "type": "string",
                "pattern": "^[^,]+$"
            }
        },
        "tags": {
            "type": "array",
            "starlist_key": "tags",
            "short_description": "Tags",
            "description": "Tags, comma separated",
            "items": {
                "description": "Tag comprised of characters other than comma",
                "type": "string",
                "pattern": "^[^,]+$"
            }
        },
        "science_target": {
            "type": "string",
            "description": "This is the name of the science target this guide star is for.",
            "short_description": "Science Target",
            "minLength": 1,
            "maxLength": 15,
            "pattern": "[\\w\\-\\s]+",
            "starlist_key": "target"
        },
        "rotator_mode": {
            "type": "string",
            "description": "Rotator Mode",
            "starlist_key": "rotmode",
            "enum": [
                "pa",
                "vertical",
                "stationary"
            ]
        },
        "rotator_pa": {
            "type": ["number", "string"],
            "starlist_key": "rotdest",
            "minimum": 0,
            "maximum": 360,
            "pattern": "^[\\+\\-]?\\d+\\.?\\d*$|^[\\+\\-]?\\.\\d+$|^\\.\\d+$|^\\d+\\.\\d+$",
            "short_description": "PA",
            "description": "Rotator Pointing Angle in degrees"
        },
        "obsid": {
            "type": "number",
            "description": "Keck Observer ID",
            "not_editable_by_user": false
        },
        "lgs": {
            "type":  "string",
            "starlist_key": "lgs",
            "description": "LGS=1, LGS=0 for NGS, select None if neither.",
            "short_description": "LGS",
            "enum": [
                "None",
                "1",
                "0"
            ]
        },
        "g_mag": {
            "type":  ["number", "string"],
            "starlist_key": "gmag",
            "description": "G Magnitude usually imported from SIMBAD.",
            "short_description": "G mag",
            "pattern": "^[\\+\\-]?\\d+\\.?\\d*$|^[\\+\\-]?\\.\\d+$|^\\.\\d+$|^\\d+\\.\\d+$"
        },
        "b_mag": {
            "type":  ["number", "string"],
            "starlist_key": "bmag",
            "description": "B Magnitude. Relavent for AO observations with the optical WFS.",
            "short_description": "B mag",
            "pattern": "^[\\+\\-]?\\d+\\.?\\d*$|^[\\+\\-]?\\.\\d+$|^\\.\\d+$|^\\d+\\.\\d+$"
        },
        "v_mag": {
            "type":  ["number", "string"],
            "starlist_key": "vmag",
            "description": "V Magnitude",
            "short_description": "V mag",
            "pattern": "^[\\+\\-]?\\d+\\.?\\d*$|^[\\+\\-]?\\.\\d+$|^\\.\\d+$|^\\d+\\.\\d+$"
        },
        "r_mag": {
            "type":  ["number", "string"],
            "starlist_key": "rmag",
            "description": "R Magnitude. Relavent for AO observations with the optical WFS.",
            "short_description": "R mag",
            "pattern": "^[\\+\\-]?\\d+\\.?\\d*$|^[\\+\\-]?\\.\\d+$|^\\.\\d+$|^\\d+\\.\\d+$"
        },
        "j_mag": {
            "type":  ["number", "string"],
            "starlist_key": "jmag",
            "description": "G Magnitude usually imported from SIMBAD.",
            "short_description": "J mag",
            "pattern": "^[\\+\\-]?\\d+\\.?\\d*$|^[\\+\\-]?\\.\\d+$|^\\.\\d+$|^\\d+\\.\\d+$"
        },
        "h_mag": {
            "type":  ["number", "string"],
            "starlist_key": "hmag",
            "description": "H Magnitude. Relavent fro AO observations with TRICK.",
            "short_description": "H mag",
            "pattern": "^[\\+\\-]?\\d+\\.?\\d*$|^[\\+\\-]?\\.\\d+$|^\\.\\d+$|^\\d+\\.\\d+$"
        },
        "k_mag": {
            "type":  ["number", "string"],
            "starlist_key": "kmag",
            "description": "K Magnitude relavent for AO observations with TRICK.",
            "short_description": "K mag",
            "pattern": "^[\\+\\-]?\\d+\\.?\\d*$|^[\\+\\-]?\\.\\d+$|^\\.\\d+$|^\\d+\\.\\d+$"
        },
        "b_m_v_mag": {
            "type":  ["number", "string"],
            "starlist_key": "b-v",
            "description": "B-V Magnitude.",
            "short_description": "B-V mag",
            "pattern": "^[\\+\\-]?\\d+\\.?\\d*$|^[\\+\\-]?\\.\\d+$|^\\.\\d+$|^\\d+\\.\\d+$"
        },
        "b_m_r_mag": {
            "type":  ["number", "string"],
            "starlist_key": "b-r",
            "description": "B-R Magnitude.",
            "short_description": "B-R mag",
            "pattern": "^[\\+\\-]?\\d+\\.?\\d*$|^[\\+\\-]?\\.\\d+$|^\\.\\d+$|^\\d+\\.\\d+$"
        },
        "equinox": {
            "starlist_key": "equinox",
            "type":  "string",
            "description": "Equinox",
            "pattern": "^\\d+\\.?\\d*$|^[\\+\\-]?\\.\\d+$|^\\.\\d+$|^\\d+\\.\\d+$"
        },
        "epoch": {
            "type":  "string",
            "description": "Epoch specific date and time (J2000)",
            "short_description": "Epoch",
            "pattern": "^\\w?\\d+\\.?\\d*$|^[\\+\\-]?\\.\\d+$|^\\.\\d+$|^\\d+\\.\\d+$"},
        "d_ra": {
            "type":  ["number", "string"],
            "starlist_key": "dra",
            "short_description": "dRA",
            "description": "Differential tracking in arcseconds RA/hour divided by 15 (positive is east)",
            "pattern": "^[\\+\\-]?\\d+\\.?\\d*$|^[\\+\\-]?\\.\\d+$|^\\.\\d+$|^\\d+\\.\\d+$"
        },
        "d_dec": {
            "type":  ["number", "string"],
            "starlist_key": "ddec",
            "short_description": "dDec",
            "description": "Differential tracking in arcseconds Dec/hour",
            "pattern": "^[\\+\\-]?\\d+\\.?\\d*$|^[\\+\\-]?\\.\\d+$|^\\.\\d+$|^\\d+\\.\\d+$"
        },
        "pm_ra": {
            "type":  ["number", "string"],
            "starlist_key": "pmra",
            "short_description": "PM RA",
            "description": "Proper Motion in arcseconds RA/second",
            "pattern": "^[\\+\\-]?\\d+\\.?\\d*$|^[\\+\\-]?\\.\\d+$|^\\.\\d+$|^\\d+\\.\\d+$"
        },
        "pm_dec": {
            "type":  ["number", "string"],
            "starlist_key": "pmdec",
            "short_description": "PM Dec",
            "description": "Proper Motion in arcseconds Dec/second",
            "pattern": "^[\\+\\-]?\\d+\\.?\\d*$|^[\\+\\-]?\\.\\d+$|^\\.\\d+$|^\\d+\\.\\d+$"
        },
        "ra_offset": {
            "type":  ["number", "string"],
            "starlist_key": "raoffset",
            "short_description": "RA Offset [arcseconds])",
            "description": "Right Ascension Offset in arcseconds (positive is east)",
            "pattern": "^[\\+\\-]?\\d+\\.?\\d*$|^[\\+\\-]?\\.\\d+$|^\\.\\d+$|^\\d+\\.\\d+$"
        },
        "dec_offset": {
            "type":  ["number", "string"],
            "starlist_key": "decoffset",
            "short_description": "Dec Offset [arcseconds]",
            "description": "Declination Offset in arcseconds (positive is north)",
            "pattern": "^[\\+\\-]?\\d+\\.?\\d*$|^[\\+\\-]?\\.\\d+$|^\\.\\d+$|^\\d+\\.\\d+$"
        },
        "ra": {
            "type": "string",
            "short_description": "RA",
            "description": "Right Ascension [HH:MM:SS.SSSS]",
            "pattern": "^([\\-\\+]?\\d{2}:\\d{2}:\\d{2}\\.?\\d*)$"
        },
        "dec": {
            "type": "string",
            "short_description": "Dec",
            "description": "Declination [(+/-)DD:MM:SS.SSSS]",
            "pattern": "^([\\-\\+]?\\d{2}:\\d{2}:\\d{2}\\.?\\d*)$"
        },
        "ra_deg": {
            "type": "number",
            "short_description": "RA [deg]",
            "description": "Right Ascension in degrees"
        },
        "dec_deg": {
            "type": "number",
            "short_description": "Dec [deg]",
            "description": "Declination in degrees"
        },
        "telescope_wrap": {
            "type": "string",
            "starlist_key": "wrap",
            "short_description": "Telescope Wrap",
            "description": "Telescope Azimuth Wrap. South is clockwise with az increasing, North is counter clockwise with az decreasing",
            "enum": [
                "shortest",
                "south",
                "north"
            ]
        },
        "comment": {
            "type": "string",
            "description": "Notes/comments"
        },
        "_id": {
            "type": "string",
            "description": "target identifier for table",
            "not_editable_by_user": true
        },
        "tic_id": {
            "type": "string",
            "short_description": "TIC ID",
            "description": "TIC Identifier"
        },
        "gaia_id": {
            "type": "string",
            "short_description": "GAIA ID",
            "description": "GAIA Identifier"
        },
        "status": {
            "type": "string",
            "description": "Status of the target. Used to track row edits vs form edits",
            "not_editable_by_user": true, 
            "enum": [
                "EDITED",
                "CREATED"
            ]
        }
    },
    "required": [
        "_id",
        "target_name",
        "ra",
        "dec",
        "equinox"
    ],
    "additionalProperties": true
}